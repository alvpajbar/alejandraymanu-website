    <section id="eng-pics" class="section-padding">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <h3 class="header">{{ sections.gallery.title }}</h3>
                </div>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    {%- for i in range(1, gallery.count + 1) %}
                    <div class="swiper-slide">
                        <img src="{{ gallery.path }}/{{ i }}.{{ gallery.ext }}" />
                    </div>
                    {%- endfor %}
                </div>
                <!--<div class="swiper-pagination"></div>-->
            </div>
        </div>
        <div class="container">
            <div class="row hidden-lg hidden-md hidden-xs">
                <div class="col-xs-12 section-border section-padding"></div>
            </div>
        </div>
    </section>
